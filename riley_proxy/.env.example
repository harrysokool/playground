# Copy to .env, fill in, then: chmod 600 .env
# Placeholders only. Never commit the real .env.

# --- Azure OpenAI (same values as the working ManagedIdentityCredential test) ---
AZURE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_DEPLOYMENT=<your-deployment-name>
AZURE_CLIENT_ID=<managed-identity-client-id-guid>
AZURE_API_VERSION=2024-12-01-preview

# --- Proxy authentication (what OpenClaw will send as its API key) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RILEY_PROXY_TOKEN=<generate-a-random-token-of-at-least-32-characters>

# --- Optional (defaults shown) ---
# Extra model names clients may send; all map to AZURE_DEPLOYMENT.
# RILEY_PROXY_MODEL_ALIASES=
# Keep 127.0.0.1 until the Docker networking design has been reviewed.
# RILEY_PROXY_HOST=127.0.0.1
# RILEY_PROXY_ALLOW_NON_LOOPBACK=
# RILEY_PROXY_PORT=8787
# RILEY_PROXY_MAX_BODY_BYTES=4194304
# RILEY_PROXY_MAX_COMPLETION_TOKENS=16384
# RILEY_PROXY_UPSTREAM_TIMEOUT=180
